<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>Lux3D.Rhino</AssemblyName>
    <RootNamespace>Lux3D.Rhino</RootNamespace>
    <Description>Lux3D for Rhino by CuriousArc and QROST / Zhongding Cui (addincui). Text-to-3D and single-image-to-3D generation, GLB previews, and native Block placement. Requires a regional Aholo API Key; Manycore OAuth sign-in is optional. Independent community integration, not an official Manycore, Aholo, or McNeel product.</Description>
    <TargetExt>.rhp</TargetExt>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" IncludeAssets="compile;build" PrivateAssets="all" />
    <ProjectReference Include="../Lux3D.Core/Lux3D.Core.csproj" />
  </ItemGroup>
</Project>
